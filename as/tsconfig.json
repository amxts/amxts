{
	"extends": "assemblyscript/std/assembly.json",
	"compilerOptions": {
		"target": "es2015",
		"moduleDetection": "force",
		"useUnknownInCatchVariables": false,
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"@amxts/core": ["./facade.ts"],
			"@amxts/core/natives": ["./natives.ts"],
			"@amxts/core/constants": ["./constants.ts"],
			"@amxts/core/fs": ["./fs.ts"],
			"@amxts/core/os": ["./os.ts"],
			"@amxts/core/kit": ["./kit.ts"],
			"@amxts/core/check": ["./lib/check.ts"],
			"@amxts/menu-core": ["../../amxts-modules/menu-core/src/index.ts"],
			"@amxts/config-core": ["../../amxts-modules/config-core/src/index.ts"]
		}
	},
	"include": [
		"./**/*.ts",
		"../amxts.config.ts",
		"../../amxts-modules/menu-core/src/index.ts",
		"../../amxts-modules/config-core/src/index.ts"
	]
}
