+# LLVM's exported targets reference LibXml2::LibXml2 through
+# LLVMWindowsManifest, which wamrc does not use. A stub keeps CMake happy
+# without requiring libxml2 to be installed.
+if (NOT TARGET LibXml2::LibXml2)
+  add_library(LibXml2::LibXml2 INTERFACE IMPORTED)
+endif()
+
 find_package(LLVM REQUIRED CONFIG)
+
+# The prebuilt LLVM was linked on a machine with Visual Studio 2019 and its
+# exported targets carry that absolute path to the DIA SDK's diaguids.lib,
+# which is only needed for reading PDBs — something wamrc never does. Point it
+# at whatever DIA SDK exists here, or drop it.
+if (WIN32 AND TARGET LLVMDebugInfoPDB)
+  file (GLOB_RECURSE AMXTS_DIAGUIDS
+        "C:/Program Files (x86)/Microsoft Visual Studio/*/*/DIA SDK/lib/amd64/diaguids.lib")
+  set (AMXTS_DIAGUIDS_FIRST "")
+  if (AMXTS_DIAGUIDS)
+    list (GET AMXTS_DIAGUIDS 0 AMXTS_DIAGUIDS_FIRST)
+  endif ()
+  if (AMXTS_DIAGUIDS_FIRST)
+    message (STATUS "amxts: using DIA SDK at ${AMXTS_DIAGUIDS_FIRST}")
+    set_property (TARGET LLVMDebugInfoPDB PROPERTY
+                  INTERFACE_LINK_LIBRARIES "${AMXTS_DIAGUIDS_FIRST}")
+  else ()
+    message (STATUS "amxts: no DIA SDK found, unlinking LLVMDebugInfoPDB")
+    set_property (TARGET LLVMDebugInfoPDB PROPERTY INTERFACE_LINK_LIBRARIES "")
+  endif ()
+endif ()
 include_directories(${LLVM_INCLUDE_DIRS})
 add_definitions(${LLVM_DEFINITIONS})
 
