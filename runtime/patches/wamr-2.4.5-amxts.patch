+/* amxts: see wasm_runtime_memory_view in wasm_export.h */
+uint8_t *
+wasm_runtime_memory_view(WASMExecEnv *exec_env, uint64_t *size)
+{
+    WASMMemoryInstance *memory =
+        wasm_get_default_memory((WASMModuleInstance *)exec_env->module_inst);
+
+    if (!memory) {
+        *size = 0;
+        return NULL;
+    }
+    *size = memory->memory_data_size;
+    return memory->memory_data;
+}
+
+uint32_t
+wasm_runtime_direct_frames(WASMModuleInstanceCommon *module_inst)
+{
+#if WASM_ENABLE_AOT_STACK_FRAME != 0
+    return (uint32_t)(((AOTModule *)((AOTModuleInstance *)module_inst)->module)
+                          ->feature_flags
+                      & (WASM_FEATURE_TINY_STACK_FRAME
+                         | WASM_FEATURE_FRAME_PER_FUNCTION));
+#else
+    (void)module_inst;
+    return 0;
+#endif
+}
+
+/* written into the host's call where the compiler can (MSVC's link-time
+   code generation): it runs before every direct call */
+#ifdef _MSC_VER
+__forceinline
+#endif
+bool
+wasm_runtime_direct_begin(WASMExecEnv *exec_env,
+                          WASMFunctionInstanceCommon *function, uint32_t frames,
+                          void **mark)
+{
+    AOTModuleInstance *module_inst = (AOTModuleInstance *)exec_env->module_inst;
+
+    /* the thread is the one the exec env first ran on, its stack the same */
+    if (!exec_env->native_stack_boundary)
+        wasm_exec_env_set_thread_info(exec_env);
+#if WASM_ENABLE_AOT_STACK_FRAME != 0
+    {
+        /* the frames as aot_alloc_frame keeps them; the mark is where they
+           stand, a tiny frame's top or a standard frame, for
+           wasm_runtime_direct_end to put them back */
+        uint32 flags = frames;
+        uint32 func_index = ((AOTFunctionInstance *)function)->func_index;
+
+        if (flags & WASM_FEATURE_TINY_STACK_FRAME) {
+            AOTTinyFrame *frame = (AOTTinyFrame *)exec_env->wasm_stack.top;
+
+            *mark = frame;
+            if (!(flags & WASM_FEATURE_FRAME_PER_FUNCTION)) {
+                if ((uint8 *)frame > exec_env->wasm_stack.top_boundary) {
+                    aot_set_exception(module_inst,
+                                      "wasm operand stack overflow");
+                    return false;
+                }
+                frame->func_index = func_index;
+                exec_env->wasm_stack.top += sizeof(AOTTinyFrame);
+            }
+        }
+        else {
+            *mark = exec_env->cur_frame;
+            if (!(flags & WASM_FEATURE_FRAME_PER_FUNCTION)
+                && !aot_alloc_standard_frame(exec_env, func_index))
+                return false;
+        }
+    }
+#else
+    (void)frames;
+    *mark = NULL;
+#endif
+    module_inst->cur_exec_env = exec_env;
+    return true;
+}
+
+bool
+wasm_runtime_direct_end(WASMExecEnv *exec_env, uint32_t frames, void *mark)
+{
+    AOTModuleInstance *module_inst = (AOTModuleInstance *)exec_env->module_inst;
+    bool ret = module_inst->cur_exception[0] == '\0';
+
+#if WASM_ENABLE_DUMP_CALL_STACK != 0
+    if (!ret)
+        aot_create_call_stack(exec_env);
+#endif
+#if WASM_ENABLE_AOT_STACK_FRAME != 0
+    /* the frames the call left taken off, down to the mark at once: what
+       aot_free_frame does one at a time */
+    if (frames & WASM_FEATURE_TINY_STACK_FRAME)
+        exec_env->wasm_stack.top = (uint8 *)mark;
+    else
+        exec_env->cur_frame = (struct WASMInterpFrame *)mark;
+#endif
+    (void)frames;
+    (void)mark;
+    return ret;
+}
