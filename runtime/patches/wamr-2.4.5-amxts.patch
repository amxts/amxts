+  set (AMXTS_DIAGUIDS_FIRST "")
+  if (AMXTS_DIAGUIDS)
+    list (GET AMXTS_DIAGUIDS 0 AMXTS_DIAGUIDS_FIRST)
+  endif ()
+  if (AMXTS_DIAGUIDS_FIRST)
+    message (STATUS "amxts: using DIA SDK at ${AMXTS_DIAGUIDS_FIRST}")
+    set_property (TARGET LLVMDebugInfoPDB PROPERTY
+                  INTERFACE_LINK_LIBRARIES "${AMXTS_DIAGUIDS_FIRST}")
+  else ()
+    message (STATUS "amxts: no DIA SDK found, unlinking LLVMDebugInfoPDB")
+    set_property (TARGET LLVMDebugInfoPDB PROPERTY INTERFACE_LINK_LIBRARIES "")
