+/* amxts: the frames the last trap left, innermost first, and forgets them */
+uint32
+wasm_runtime_take_trap_frames(WASMModuleInstanceCommon *module_inst,
+                              WASMCApiFrame *buffer, uint32 length)
+{
+    Vector *frames = ((WASMModuleInstance *)module_inst)->frames;
+    uint32 count = 0, i, size;
+
+    if (!frames)
+        return 0;
+    size = (uint32)bh_vector_size(frames);
+    for (i = 0; i < size; i++) {
+        WASMCApiFrame frame;
+        if (!bh_vector_get(frames, i, &frame))
+            break;
+        if (frame.lp)
+            wasm_runtime_free(frame.lp);
+        if (count < length) {
+            frame.lp = NULL;
+            buffer[count++] = frame;
+        }
+    }
+    bh_vector_destroy(frames);
+    return count;
+}
