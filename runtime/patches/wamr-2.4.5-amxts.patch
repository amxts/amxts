+/* amxts: whether the machine code is for a CPU with SSE2: --cpu=pentium4
+   and every one after it, not a bare --target=i386. */
+bool
+aot_target_has_sse2(const AOTCompContext *comp_ctx)
+{
+    const llvm::MCSubtargetInfo *info =
+        reinterpret_cast<llvm::TargetMachine *>(comp_ctx->target_machine)
+            ->getMCSubtargetInfo();
+    return info != nullptr && info->checkFeatures("+sse2");
+}
