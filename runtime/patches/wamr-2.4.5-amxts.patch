+static uint32
+real_plt_prefix_len(const char *symbol)
+{
+    if (!strncmp(symbol, REAL_PLT_PREFIX, strlen(REAL_PLT_PREFIX)))
+        return (uint32)strlen(REAL_PLT_PREFIX);
+    if (!strncmp(symbol, REAL_PLT_PREFIX_I386, strlen(REAL_PLT_PREFIX_I386)))
+        return (uint32)strlen(REAL_PLT_PREFIX_I386);
+    return 0;
