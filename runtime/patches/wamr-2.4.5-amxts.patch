+/* amxts: a direct call, see wasm_runtime_direct_entry in wasm_export.h */
+void *
+wasm_runtime_direct_entry(WASMFunctionInstanceCommon *function)
+{
+    AOTFunctionInstance *func = (AOTFunctionInstance *)function;
