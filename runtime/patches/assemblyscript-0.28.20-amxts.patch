+    let module = this.module;
+    let usizeType = this.options.usizeType;
+    if (local.closureBox < 0) return module.nop();
+    return module.store(1,
+      module.local_get(local.closureBox, usizeType.toRef()),
+      module.i32(1),
+      TypeRef.I32, local.type.byteSize
