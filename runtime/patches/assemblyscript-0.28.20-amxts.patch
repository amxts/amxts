+  atom(): RegExpNode {
+    let c = this.next();
+    switch (c) {
+      case 0x2E: return new RegExpNode(N_ANY); // .
+      case 0x5E: return new RegExpNode(N_ASSERT, OP_BOL); // ^
+      case 0x24: return new RegExpNode(N_ASSERT, OP_EOL); // $
+      case 0x5B: return new RegExpNode(N_CLASS, this.bracketClass()); // [
+      case 0x28: return this.group(); // (
+      case 0x5C: return this.escape(); // \
+      case 0x2A: case 0x2B: case 0x3F: this.fail("Nothing to repeat");
+      case 0x29: this.fail("Unmatched ')'");
+    }
+    return new RegExpNode(N_CHAR, c);
+  }
+
+  group(): RegExpNode {
+    let node: RegExpNode;
+    if (this.eat(0x3F /* ? */)) {
+      if (this.eat(0x3A /* : */)) {
+        node = new RegExpNode(N_GROUP, -1);
+      } else if (this.eat(0x3D /* = */)) {
+        node = new RegExpNode(N_LOOK, 0);
+      } else if (this.eat(0x21 /* ! */)) {
+        node = new RegExpNode(N_LOOK, 1);
+      } else {
+        this.fail("lookbehind and named groups are not supported");
+        return new RegExpNode(N_SEQ);
+      }
+    } else {
+      node = new RegExpNode(N_GROUP, ++this.groups);
+    }
+    node.children.push(this.alternation());
+    if (!this.eat(0x29)) this.fail("Unterminated group");
+    return node;
+  }
+
+  escape(): RegExpNode {
+    if (!this.more()) this.fail("\\ at end of pattern");
+    let c = this.next();
+    switch (c) {
+      case 0x62: return new RegExpNode(N_ASSERT, OP_WORD, 0); // \b
+      case 0x42: return new RegExpNode(N_ASSERT, OP_WORD, 1); // \B
+      case 0x64: case 0x44: case 0x77: case 0x57: case 0x73: case 0x53: { // \d \D \w \W \s \S
+        let cls = new RegExpClass();
+        addShorthand(cls.ranges, c | 0x20);
+        cls.negate = c < 0x60;
+        return new RegExpNode(N_CLASS, this.addClass(cls));
+      }
+    }
+    if (c >= 0x31 && c <= 0x39) { // \1 - \9...
+      this.pos--;
+      return new RegExpNode(N_BACKREF, this.number());
+    }
+    return new RegExpNode(N_CHAR, this.escapedChar(c));
+  }
+
+  /** The code unit an escape other than a class stands for. */
+  escapedChar(c: i32): i32 {
+    switch (c) {
+      case 0x6E: return 0x0A; // \n
+      case 0x74: return 0x09; // \t
+      case 0x72: return 0x0D; // \r
+      case 0x66: return 0x0C; // \f
+      case 0x76: return 0x0B; // \v
+      case 0x30: return 0;    // \0
+      case 0x78: return this.hex(2); // \xHH
+      case 0x75: return this.hex(4); // \uHHHH
+      case 0x70: case 0x50: this.fail("\\p{...} is not supported");
+    }
+    return c;
+  }
+
+  hex(digits: i32): i32 {
+    let value = 0;
+    for (let i = 0; i < digits; ++i) {
+      if (!this.more()) this.fail("Invalid escape");
+      let c = this.next();
+      let d = c >= 0x30 && c <= 0x39 ? c - 0x30 : (c | 0x20) >= 0x61 && (c | 0x20) <= 0x66 ? (c | 0x20) - 0x57 : -1;
