+      entry.internalName,
+      entry.signature.paramRefs,
+      entry.signature.resultRefs,
+      typesToRefs(entry.getNonParameterLocalTypes()),
+      call
+    );
+    entry.set(CommonFlags.Compiled);
+    entry.finalize(module, funcRef);
+    return entry;
+  }
