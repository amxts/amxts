+/** The calls between functions: who calls whom, and the functions that call through a table. */
+class Calls extends Pass {
+  callers: Map<string, string[]> = new Map();
+  makers: Set<string> = new Set();
+  indirect: Set<string> = new Set();
+  private current: string = "";
