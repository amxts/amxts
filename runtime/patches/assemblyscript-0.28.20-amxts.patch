+    let module = this.module;
+    let forwarded = new Array<ExpressionRef>();
+    let thisType = signature.thisType;
+    if (thisType) forwarded.push(module.local_get(0, thisType.toRef()));
+    let parameterTypes = signature.parameterTypes;
+    for (let i = 0, k = parameterTypes.length; i < k; ++i) {
+      forwarded.push(module.local_get(forwarded.length, parameterTypes[i].toRef()));
+    }
