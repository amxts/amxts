+    let max = 0;
+    if (c == 0x2A /* * */) { min = 0; max = -1; this.pos++; }
+    else if (c == 0x2B /* + */) { min = 1; max = -1; this.pos++; }
+    else if (c == 0x3F /* ? */) { min = 0; max = 1; this.pos++; }
