+    let text = this.text;
+    let position = this.position;
+    if (position >= text.length) throw new SyntaxError("Unexpected end of JSON input");
+    throw new SyntaxError(`Unexpected token ${text.charAt(position)} in JSON at position ${position}`);
+  }
+
