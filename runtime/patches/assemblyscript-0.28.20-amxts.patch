+  /** amxts: whether a function was declared `async`. */
+  isAsyncFunction(instance: Function): bool {
+    return instance.prototype.functionTypeNode.isAsync && !instance.is(CommonFlags.Stub);
+  }
+
+  /** amxts: a function of the hood (as/async.ts, `@global`), or null with an error. */
+  private asyncHood(name: string, reportNode: Node, typeArguments: Type[] | null = null): Function | null {
+    let element = this.program.lookup(name);
+    if (!element || element.kind != ElementKind.FunctionPrototype) {
+      this.error(
+        DiagnosticCode.Cannot_find_name_0,
+        reportNode.range, name
+      );
+      return null;
+    }
+    return this.resolver.resolveFunction(<FunctionPrototype>element, typeArguments);
+  }
+
+  /** amxts: the Promise an async function settles; void when its callers never see it. */
+  private asyncPromiseClass(instance: Function, reportNode: Node): Class | null {
+    let returnType = instance.signature.returnType;
+    if (returnType == Type.void) {
+      let promise = this.resolver.promiseTypeOf(Type.void, reportNode);
+      return promise ? promise.classReference : null;
+    }
+    let promiseClass = returnType.classReference;
+    if (!promiseClass || !this.resolver.isPromisePrototype(promiseClass.prototype)) {
+      this.error(
+        DiagnosticCode.The_return_type_of_an_async_function_or_method_must_be_the_global_Promise_T_type,
+        reportNode.range
+      );
+      return null;
+    }
+    return promiseClass;
+  }
