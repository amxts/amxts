+      this.currentType = tee ? type : Type.void;
+      return module.unreachable();
+    }
+    box = this.makeTdzCheck(local, box, reportNode);
+    let setFn = this.asyncHood("__box_set", reportNode, [ type ]);
+    if (!setFn) return module.unreachable();
+    let expr = this.makeCallDirect(setFn, [ box, this.ensureSmallIntegerWrap(valueExpr, type) ], reportNode);
+    if (tee) {
+      this.currentType = type;
+      return expr;
+    }
+    this.currentType = Type.void;
+    return module.drop(expr);
+  }
+
+  /** amxts: what the closure being made keeps for `local` - see makeClosure. */
+  private makeClosureSlotContent(local: Local, reportNode: Node): ExpressionRef {
+    let module = this.module;
+    let flow = this.currentFlow;
+    // Not this function's: this function is a closure too, and has it in a slot.
+    if (local.parent != flow.targetFunction) return this.makeClosureSlot(local, reportNode);
+    if (local.closureBox >= 0) return module.local_get(local.closureBox, this.options.usizeType.toRef());
+    let type = local.type;
+    if (local.name == CommonNames.this_) flow.set(FlowFlags.AccessesThis);
+    let value = module.local_get(local.index, type.toRef());
+    if (type.isReference) return value;
+    let boxFn = this.asyncHood("__box", reportNode, [ type ]);
+    if (!boxFn) return module.unreachable();
+    return this.makeCallDirect(boxFn, [ value ], reportNode);
+  }
+
+  /** amxts: the Function object of a closure, with its `_env` - see the top of this section. */
+  private makeClosure(fnExpr: ExpressionRef, slots: Local[], reportNode: Node): ExpressionRef {
+    let module = this.module;
+    let flow = this.currentFlow;
+    let usizeType = this.options.usizeType;
+    let usizeRef = usizeType.toRef();
+    let envFn = this.asyncHood("__closure_env", reportNode);
+    let setFn = this.asyncHood("__closure_set", reportNode);
+    let makeFn = this.asyncHood("__closure", reportNode);
+    if (!envFn || !setFn || !makeFn) return module.unreachable();
+    let env = flow.getTempLocal(usizeType);
+    let stmts = new Array<ExpressionRef>();
+    stmts.push(module.local_set(env.index, this.makeCallDirect(envFn, [ module.i32(slots.length) ], reportNode), true));
+    for (let i = 0, k = slots.length; i < k; ++i) {
+      stmts.push(this.makeCallDirect(setFn, [
+        module.local_get(env.index, usizeRef),
+        module.i32(i),
+        this.makeClosureSlotContent(slots[i], reportNode)
+      ], reportNode, true));
+    }
+    stmts.push(this.makeCallDirect(makeFn, [ fnExpr, module.local_get(env.index, usizeRef) ], reportNode));
+    return module.flatten(stmts, usizeRef);
+  }
+
+  // === amxts: async functions ===================================================================
+  //
+  // An async function runs as a coroutine of its own. Called as usual it
+  // makes its Promise and asks the host (co_spawn) to call it again, through
+  // the table, with the same arguments; that second call runs the body. If the
+  // body parks at an `await`, Asyncify unwinds it to the host alone and the
+  // caller carries on with the Promise - as in JavaScript, a call without
+  // `await` does not wait. The host resumes it later from the top, so no
+  // `await` is ever reached through an indirect call, and Binaryen's own call
+  // graph, from the one suspending import, is the list of what to instrument.
+  // The runtime half is as/async.ts, the host's is runtime/src/module.cpp.
