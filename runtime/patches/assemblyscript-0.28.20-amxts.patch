+    if (target == NEW) this.makers.add(this.current);
+    let callers = this.callers.get(target);
+    if (!callers) this.callers.set(target, callers = []);
+    callers.push(this.current);
+  }
+
+  /** @override */
+  visitCallIndirect(call: ExpressionRef): void {
+    this.indirect.add(this.current);
+  }
+}
+
+/** A function's expressions by their parent, its locals' reads and writes, its allocations and returns. */
+class Body extends Pass {
+  parents: Map<ExpressionRef, ExpressionRef> = new Map();
+  gets: Map<Index, ExpressionRef[]> = new Map();
+  sets: Map<Index, ExpressionRef[]> = new Map();
+  news: ExpressionRef[] = [];
+  returns: ExpressionRef[] = [];
+  tailCalls: bool = false;
+  /** The reads and writes of the shadow stack's pointer. */
+  stackPointerGets: ExpressionRef[] = [];
+  stackPointerSets: ExpressionRef[] = [];
+
+  /** @override */
+  visitGlobalGet(expr: ExpressionRef): void {
+    if (this.module.readStringCached(_BinaryenGlobalGetGetName(expr)) == STACK_POINTER) this.stackPointerGets.push(expr);
+  }
+
+  /** @override */
+  visitGlobalSet(expr: ExpressionRef): void {
+    if (this.module.readStringCached(_BinaryenGlobalSetGetName(expr)) == STACK_POINTER) this.stackPointerSets.push(expr);
+  }
+
+  /** @override */
+  visit(expr: ExpressionRef): void {
+    let parent = this.parentExpressionOrNull;
+    if (parent) this.parents.set(expr, parent);
+    super.visit(expr);
+  }
+
+  /** @override */
+  visitLocalGet(expr: ExpressionRef): void {
+    let index = _BinaryenLocalGetGetIndex(expr);
+    let gets = this.gets.get(index);
+    if (!gets) this.gets.set(index, gets = []);
+    gets.push(expr);
+  }
+
+  /** @override */
+  visitLocalSet(expr: ExpressionRef): void {
+    let index = _BinaryenLocalSetGetIndex(expr);
+    let sets = this.sets.get(index);
+    if (!sets) this.sets.set(index, sets = []);
+    sets.push(expr);
+  }
+
+  /** @override */
+  visitCall(call: ExpressionRef): void {
+    if (_BinaryenCallIsReturn(call)) this.tailCalls = true;
+    if (this.module.readStringCached(_BinaryenCallGetTarget(call)) == NEW) this.news.push(call);
+  }
+
+  /** @override */
+  visitCallIndirect(call: ExpressionRef): void {
+    if (_BinaryenCallIndirectIsReturn(call)) this.tailCalls = true;
+  }
+
+  /** @override */
+  visitReturn(expr: ExpressionRef): void {
+    this.returns.push(expr);
+  }
+}
