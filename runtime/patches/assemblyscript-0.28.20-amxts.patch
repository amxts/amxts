+   * and - when it calls itself by its name, as `function f(n) { ... f(n - 1) }`
+   * may - a box holding itself, in a scope of its own that only its body
+   * sees. Returns the declaration of that box, or 0.
+   */
+  private prepareFunctionExpression(instance: Function, declaration: FunctionDeclaration, flow: Flow): ExpressionRef {
+    let signature = instance.signature;
+    if (signature.requiredParameters < signature.parameterTypes.length) instance.closureDefaults = true;
+    instance.flow.outer = flow;
+    if (!functionUsesItsName(declaration)) return 0;
+    let scope = flow.fork();
+    let self = scope.addScopedLocal(declaration.name.text, instance.type);
+    self.closureAssigned = true;
+    instance.flow.outer = scope;
+    instance.closureSelf = self;
+    let previousFlow = this.currentFlow;
+    this.currentFlow = flow;
+    let expr = this.makeBoxedDeclaration(self, this.makeZero(instance.type), declaration);
+    this.currentFlow = previousFlow;
+    return expr;
+  }
+
+  /**
+   * amxts: `function name() {}` inside a function body is a closure made at
+   * the start of its block, as JavaScript hoists it: it may be called above
+   * its declaration, and functions of one block may call each other. Each
+   * name lives in a box made first, as do the block's variables the functions
+   * use, whose declarations further down then fill the box they find.
+   * Returns the statements already compiled, or null when there are none.
+   */
+  private hoistFunctions(statements: Statement[], stmts: ExpressionRef[]): Set<Statement> | null {
+    let flow = this.currentFlow;
+    let declarations: FunctionExpression[] | null = null;
+    let hoisted: Set<Statement> | null = null;
+    // amxts: the block's variables that a closure written above their
+    // declaration uses - `const f = () => x; ...; let x = 1` - JavaScript
+    // lets it, and throws if it runs before the declaration has (makeTdzCheck)
+    let usedAbove: Set<string> | null = null;
+    let capturedSoFar: Set<string> | null = null;
+    for (let i = 0, k = statements.length; i < k; ++i) {
+      let statement = statements[i];
+      if (statement.kind == NodeKind.Variable && capturedSoFar) {
+        let variables = (<VariableStatement>statement).declarations;
+        for (let j = 0, l = variables.length; j < l; ++j) {
+          let name = variables[j].name.text;
+          if (capturedSoFar.has(name)) {
+            if (!usedAbove) usedAbove = new Set<string>();
+            usedAbove.add(name);
+          }
+        }
+      }
+      if (statement.kind != NodeKind.Expression || (<ExpressionStatement>statement).expression.kind != NodeKind.Function) {
+        if (mayHaveFunctionExpression(statement)) {
+          let captured = scanClosures(statement).captured;
+          if (captured.size) {
+            if (!capturedSoFar) capturedSoFar = new Set<string>();
+            for (let _values = Set_values(captured), j = 0, l = _values.length; j < l; ++j) capturedSoFar.add(_values[j]);
+          }
+        }
+        continue;
+      }
+      let expression = (<ExpressionStatement>statement).expression;
+      let declaration = (<FunctionExpression>expression).declaration;
+      if (!declaration.name.text.length || declaration.arrowKind != ArrowKind.None) {
+        let captured = scanClosures(statement).captured;
+        if (captured.size) {
+          if (!capturedSoFar) capturedSoFar = new Set<string>();
+          for (let _values = Set_values(captured), j = 0, l = _values.length; j < l; ++j) capturedSoFar.add(_values[j]);
+        }
+        continue;
+      }
+      if (!declarations) {
+        declarations = new Array<FunctionExpression>();
+        hoisted = new Set<Statement>();
+      }
+      declarations.push(<FunctionExpression>expression);
+      assert(hoisted).add(statement);
+    }
+    if (!declarations && !usedAbove) return null;
+    let module = this.module;
+    let resolver = this.resolver;
+
+    // What the functions use of the block's own variables.
+    let used = new Set<string>();
+    if (usedAbove) {
+      for (let _values = Set_values(usedAbove), j = 0, l = _values.length; j < l; ++j) used.add(_values[j]);
+    }
+    if (!declarations) declarations = new Array<FunctionExpression>();
+    for (let i = 0, k = declarations.length; i < k; ++i) {
+      let captured = scanClosures(declarations[i]).captured;
+      for (let _values = Set_values(captured), j = 0, l = _values.length; j < l; ++j) used.add(_values[j]);
+    }
+
+    // The functions' names and the block's variables they use, in boxes,
+    // typed by their signatures and initializers. A function that returns a
+    // variable declared further down is typed once that variable is, and a
+    // variable initialized by a call to such a function once the function
+    // is: round after round while one more is typed, then what is left
+    // reports why.
+    let names = new Array<Local>(declarations.length);
+    let variables = new Array<VariableDeclaration>();
+    for (let i = 0, k = statements.length; i < k; ++i) {
+      let statement = statements[i];
+      if (statement.kind != NodeKind.Variable) continue;
+      let declared = (<VariableStatement>statement).declarations;
+      for (let j = 0, l = declared.length; j < l; ++j) {
+        let variable = declared[j];
+        if (used.has(variable.name.text) && variable.isAny(CommonFlags.Let | CommonFlags.Const)) variables.push(variable);
+      }
+    }
+    let typedVariables = new Set<VariableDeclaration>();
+    for (let round = 0; ; ++round) {
+      let last = round > declarations.length + variables.length;
+      let reportMode = last ? ReportMode.Report : ReportMode.Swallow;
+      let progress = false;
+      for (let i = 0, k = declarations.length; i < k; ++i) {
+        if (names[i]) continue;
+        let expression = declarations[i];
+        let type = resolver.resolveExpression(expression, flow, Type.auto, reportMode);
+        if (!type) continue;
+        let local = flow.addScopedLocal(expression.declaration.name.text, type);
+        local.closureAssigned = true;
+        flow.setLocalFlag(local.index, LocalFlags.Initialized);
+        stmts.push(this.makeBoxedDeclaration(local, this.makeZero(type), expression));
+        names[i] = local;
+        progress = true;
+      }
+      for (let i = 0, k = variables.length; i < k; ++i) {
+        let variable = variables[i];
+        let name = variable.name.text;
+        if (typedVariables.has(variable) || flow.getScopedLocal(name)) continue;
+        let typeNode = variable.type;
+        let initializer = variable.initializer;
+        let type: Type | null = typeNode
+          ? resolver.resolveType(typeNode, flow, flow.sourceFunction, cloneMap(flow.contextualTypeArguments), ReportMode.Swallow)
+          : initializer ? resolver.resolveExpression(initializer, flow, Type.auto, ReportMode.Swallow) : null;
+        if (!type || type == Type.void) continue;
+        let local = flow.addScopedLocal(name, type);
+        local.closureAssigned = true;
+        local.closurePredeclared = true;
+        flow.setLocalFlag(local.index, LocalFlags.Initialized);
+        stmts.push(this.makeBoxedDeclaration(local, this.makeZero(type), variable, true));
+        typedVariables.add(variable);
+        progress = true;
+      }
+      if (last) break;
+      if (!progress) round = declarations.length + variables.length; // next round reports
+    }
