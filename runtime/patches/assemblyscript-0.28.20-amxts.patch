+        }
+        default: {
+          --this.position;
+          this.unexpected();
+        }
+      }
+      start = this.position;
+    }
+    let tail = text.substring(start, this.position);
+    ++this.position; // "
+    if (!parts) return tail;
+    parts.push(tail);
+    return parts.join("");
+  }
+}
+
+/** @hidden JSON text as values; a SyntaxError where it is not JSON. */
+export function __jsonParse(text: string): __JsonValue {
+  return new JsonParser(text).parse();
+}
+
+/** @hidden where a field is, for a message: `a.b`. */
+export function __jsonPath(path: string, name: string): string {
+  return path.length ? path + "." + name : name;
+}
+
+/** @hidden a TypeError: the JSON at `path` is not what the type says. */
+export function __jsonMismatch(value: __JsonValue | null, path: string, wanted: string): void {
+  let where = path.length ? path : "the value";
+  if (!value) throw new TypeError(`JSON: ${where} is missing, ${wanted} was expected`);
+  throw new TypeError(`JSON: ${where} is ${value.kindName}, ${wanted} was expected`);
+}
+
+/** @hidden a T from a JSON value - see JSON.parse. `path` names it in a message. */
+export function __jsonRead<T>(value: __JsonValue | null, path: string): T {
+  if (isNullable<T>()) {
+    if (!value || value.kind == NULL) return changetype<T>(0);
+  }
+  if (isString<T>()) {
+    if (!value || value.kind != STRING) __jsonMismatch(value, path, "text");
+    return changetype<T>((<__JsonValue>value).text);
+  }
+  if (isBoolean<T>()) {
+    if (!value || value.kind != BOOLEAN) __jsonMismatch(value, path, "a boolean");
+    return <T>(<__JsonValue>value).flag;
+  }
+  if (isInteger<T>() || isFloat<T>()) {
+    if (!value || value.kind != NUMBER) __jsonMismatch(value, path, "a number");
+    return <T>(<__JsonValue>value).number;
+  }
+  if (isArray<T>()) {
+    if (!value || value.kind != ARRAY) __jsonMismatch(value, path, "an array");
+    let items = <__JsonValue[]>(<__JsonValue>value).items;
+    let list = instantiate<T>(0);
+    for (let i = 0, k = items.length; i < k; ++i) {
+      // @ts-ignore: an array's push
+      list.push(__jsonRead<valueof<T>>(unchecked(items[i]), `${path}[${i}]`));
+    }
+    return list;
+  }
+  if (isReference<T>()) {
+    if (!value || value.kind != OBJECT) __jsonMismatch(value, path, "an object");
+    // @ts-ignore: a Record fills itself; an object of fields is the compiler's
+    if (isDefined(changetype<T>(0).__jsonFill)) {
+      let record = instantiate<T>();
+      // @ts-ignore: a Record's
+      record.__jsonFill(<__JsonValue>value, path);
+      return record;
+    }
+    return __jsonReadFields<T>(<__JsonValue>value, path);
+  }
