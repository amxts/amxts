+  depth: i32 = 0;
+  /** Whether the object or array being written has had an item. */
+  started: bool[] = [];
+
+  constructor(public indent: string) {}
+
+  /** Before an item of an array, or a key of an object. */
+  private item(): void {
+    let started = this.started;
+    let last = started.length - 1;
+    if (unchecked(started[last])) this.parts.push(",");
+    else unchecked(started[last] = true);
+    if (this.indent.length) this.parts.push("\n" + this.indent.repeat(this.depth));
+  }
+
+  open(bracket: string): void {
+    this.parts.push(bracket);
+    this.started.push(false);
+    ++this.depth;
+  }
+
+  close(bracket: string): void {
+    --this.depth;
+    if (this.started.pop() && this.indent.length) this.parts.push("\n" + this.indent.repeat(this.depth));
+    this.parts.push(bracket);
+  }
+
+  /** Before an item of an array. */
+  element(): void {
+    this.item();
+  }
+
+  /** An object's key, before its value. */
+  key(key: string): void {
+    this.item();
+    this.text(key);
+    this.parts.push(this.indent.length ? ": " : ":");
+  }
+
+  raw(text: string): void {
+    this.parts.push(text);
+  }
+
+  number(value: f64): void {
+    this.parts.push(isFinite(value) ? dtoa(value) : "null");
+  }
