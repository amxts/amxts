+/** @hidden an object of T's fields from a JSON object - the compiler's (Compiler.compileJsonReadFields). */
+// @ts-ignore: decorator
+@builtin
+export declare function __jsonReadFields<T>(value: __JsonValue, path: string): T;
+
+/** @hidden writes T's fields as a JSON object - the compiler's (Compiler.compileJsonWriteFields). */
+// @ts-ignore: decorator
+@builtin
+export declare function __jsonWriteFields<T>(value: T, writer: __JsonWriter): void;
+
+/** @hidden JSON text being written, with the indentation JSON.stringify was given. */
+export class __JsonWriter {
