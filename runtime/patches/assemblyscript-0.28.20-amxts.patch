--- a/std/assembly/util/number.ts
+++ b/std/assembly/util/number.ts
@@ -749,12 +749,17 @@ export function dtoa<T extends number>(value: T): String {
 // @ts-ignore: decorator
 @inline
 function dtoa_impl(value: f64, isSingle: bool): String {
-  if (value == 0) return "0.0";
+  // amxts: a number prints as JavaScript prints it - 100, not 100.0. A
+  // plugin's numbers are all f64, so `${player.health} HP` said "100.0 HP".
+  if (value == 0) return "0";
   if (!isFinite(value)) {
+    // amxts: the NaN that stands for undefined - an optional number left out
+    // (Compiler.makeUndefinedNumber) - prints as JavaScript prints undefined.
+    if (!isSingle && reinterpret<u64>(value) == 0x7FFD000000000000) return "undefined";
     if (isNaN(value)) return "NaN";
     return select<String>("-Infinity", "Infinity", value < 0);
   }
-  let size = dtoa_core(dtoa_buf, value, isSingle) << 1;
+  let size = wholeWithoutFraction(dtoa_buf, dtoa_core(dtoa_buf, value, isSingle)) << 1;
   let result = changetype<String>(__new(size, idof<String>()));
   memory.copy(changetype<usize>(result), dtoa_buf, size);
   return result;
@@ -846,11 +851,10 @@ export function dtoa_buffered<T extends number>(buffer: usize, value: T): u32 {
 // @ts-ignore: decorator
 @inline
 function dtoa_buffered_impl(buffer: usize, value: f64, isSingle: bool): u32 {
+  // amxts: "0", and a whole number without ".0" - as in dtoa_impl.
   if (value == 0) {
     store<u16>(buffer, CharCode._0);
-    store<u16>(buffer, CharCode.DOT, 2);
-    store<u16>(buffer, CharCode._0,  4);
-    return 3;
+    return 1;
   }
   if (!isFinite(value)) {
     if (isNaN(value)) {
@@ -869,5 +873,21 @@ function dtoa_buffered_impl(buffer: usize, value: f64, isSingle: bool): u32 {
       return 8 + u32(sign);
     }
   }
-  return dtoa_core(buffer, value, isSingle);
+  return wholeWithoutFraction(buffer, dtoa_core(buffer, value, isSingle));
+}
+
+/**
+ * amxts: the length of a formatted number with a trailing ".0" dropped.
+ * dtoa_core writes 100 as "100.0"; JavaScript writes "100", and a plugin's
+ * numbers are JavaScript's. "1e+21" and "3.5" end otherwise and stay.
+ */
+// @ts-ignore: decorator
+@inline
+function wholeWithoutFraction(buffer: usize, length: i32): i32 {
+  if (
+    length >= 2 &&
+    load<u16>(buffer + ((<usize>length - 1) << 1)) == CharCode._0 &&
+    load<u16>(buffer + ((<usize>length - 2) << 1)) == CharCode.DOT
+  ) return length - 2;
+  return length;
 }
