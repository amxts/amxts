+    let module = this.module;
+    let usizeType = this.options.usizeType;
+    let temp = this.currentFlow.getTempLocal(usizeType);
+    return module.block(null, [
+      module.if(
+        module.unary(UnaryOp.EqzI32,
+          module.load(1, false, module.local_tee(temp.index, box, false), TypeRef.I32, local.type.byteSize)
