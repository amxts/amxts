+  private string(): string {
+    let text = this.text;
+    ++this.position; // "
+    let parts: string[] | null = null;
+    let start = this.position;
+    while (true) {
+      if (this.position >= text.length) this.unexpected();
+      let code = text.charCodeAt(this.position);
+      if (code == 0x22) break;
+      if (code < 0x20) this.unexpected();
+      if (code != 0x5C) {
