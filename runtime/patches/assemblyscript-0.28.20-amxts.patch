+const RESUME: i32 = 0;
+const CAPTURE: i32 = 1;
+const REGISTER: i32 = 2;
+
+/** A step budget for one match: a pattern that backtracks without end stops there. */
+const MAX_STEPS: i32 = 5_000_000;
+
+class RegExpNode {
+  children: RegExpNode[] = [];
+  constructor(
+    public kind: i32,
+    /** A code unit, a class, a group, an assertion's op or a back-reference's group. */
+    public value: i32 = 0,
+    public min: i32 = 0,
+    /** -1: no end. */
+    public max: i32 = 0,
+    public greedy: bool = true
+  ) {}
+}
+
+/** A class: ranges of code units, pairs of first and last, and whether it is negated. */
+class RegExpClass {
+  ranges: i32[] = [];
+  negate: bool = false;
+
+  has(c: i32): bool {
+    let ranges = this.ranges;
+    for (let i = 0, k = ranges.length; i < k; i += 2) {
+      if (c >= unchecked(ranges[i]) && c <= unchecked(ranges[i + 1])) return true;
+    }
+    return false;
+  }
+}
+
+/** The parser: a pattern into a tree, and the classes and group count it finds. */
+class RegExpParser {
+  pos: i32 = 0;
+  groups: i32 = 0;
+  classes: RegExpClass[] = [];
