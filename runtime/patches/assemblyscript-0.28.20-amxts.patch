+/** The collector's allocation, which an object made in a frame replaces. */
+const NEW = "~lib/rt/itcms/__new";
+/** The shadow stack's pointer. */
+const STACK_POINTER = "~lib/memory/__stack_pointer";
+/** The largest object made in a frame, in bytes, and the most a function takes for them. */
+const MAX_OBJECT = 256;
+const MAX_FRAME = 1024;
+/** A collector's object header before its fields (common.ts TOTAL_OVERHEAD), and its slot in a frame. */
+const HEADER = 20;
+const SLOT_HEADER = 32;
+/** The collector's colour of a static object, which it never frees and never visits (itcms.ts). */
+const TRANSPARENT = 3;
+/** The word that starts a function's objects in its frame, before their extent in bytes: no reference is -1. */
+const MARK = -1;
+/** The label the body is wrapped in, which a return becomes a branch to. */
+const BODY = "~stack_objects";
