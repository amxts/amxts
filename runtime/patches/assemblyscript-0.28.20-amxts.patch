+// The program: three i32 per instruction - an op and its two arguments.
+const OP_CHAR: i32 = 0;      // a: the code unit
+const OP_ANY: i32 = 1;       // a: 1 when it takes a line break too (the s flag)
+const OP_CLASS: i32 = 2;     // a: the class
+const OP_SPLIT: i32 = 3;     // a: tried first, b: tried when a fails
+const OP_JMP: i32 = 4;       // a: where
+const OP_SAVE: i32 = 5;      // a: the capture slot
+const OP_BOL: i32 = 6;
+const OP_EOL: i32 = 7;
+const OP_WORD: i32 = 8;      // a: 1 for \B
+const OP_BACKREF: i32 = 9;   // a: the group
+const OP_MARK: i32 = 10;     // a: the register that keeps where a loop's round started
+const OP_PROGRESS: i32 = 11; // a: the register - fails when the round matched nothing
+const OP_LOOK: i32 = 12;     // a: 1 for (?!), b: where the lookahead's program ends
+const OP_MATCH: i32 = 13;
+const OP_CLEAR: i32 = 14;    // a, b: the first and last capture slot a round of a loop starts empty
+
+// The tree
+const N_CHAR: i32 = 0;
+const N_ANY: i32 = 1;
+const N_CLASS: i32 = 2;
+const N_SEQ: i32 = 3;
+const N_ALT: i32 = 4;
+const N_REPEAT: i32 = 5;
+const N_GROUP: i32 = 6;
+const N_ASSERT: i32 = 7;
+const N_BACKREF: i32 = 8;
+const N_LOOK: i32 = 9;
+
