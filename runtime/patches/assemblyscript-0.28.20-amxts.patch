index 47a4a7a..e53a72f 100644
--- a/std/assembly/number.ts
+++ b/std/assembly/number.ts
@@ -383,6 +383,122 @@ export abstract class F64 {
   toString(this: f64, radix: i32 = 0): String {
     return dtoa(this);
   }
+
+  // amxts: JavaScript's toFixed, to the digit: the number's exact value, not
+  // a scaled copy, is rounded - (1.45).toFixed(1) is "1.4", since 1.45 is
+  // 1.4499999999999999556. From 1e21 on it is written as toString writes it.
+  // The places are a number, made an integer as JavaScript makes one - cut
+  // toward zero, NaN is 0 - before the range is checked, so -Infinity and
+  // 2 ** 32 + 2 throw rather than wrap into it.
+  toFixed(this: f64, fractionDigits: f64 = 0): String {
+    let places = isNaN(fractionDigits) ? 0 : Math.trunc(fractionDigits);
+    if (!(places >= 0 && places <= 100)) throw new RangeError("toFixed() digits argument must be between 0 and 100");
+    let count = <i32>places;
+    if (!isFinite(this) || Math.abs(this) >= 1e21) return dtoa(this);
+    let digits = fixedDigits(Math.abs(this), count);
+    if (count > 0) {
+      if (digits.length <= count) digits = "0".repeat(count + 1 - digits.length) + digits;
+      let point = digits.length - count;
+      digits = digits.substring(0, point) + "." + digits.substring(point);
+    }
+    return this < 0 ? "-" + digits : digits;
+  }
+}
+
+// amxts: toFixed's arithmetic, on the double's exact value. A finite double is
+// mantissa * 2^exponent; times 10^places that is a whole number when the
+// exponent is not negative, and otherwise one halving shift away from it. So
+// n = round(value * 10^places) - a tie going up, as the specification picks the
+// larger n - is done on a whole number of 32-bit limbs, lowest first, and
+// written out in decimal. No float is scaled, so no digit is lost to rounding.
+function fixedDigits(value: f64, places: i32): String {
+  let bits = reinterpret<u64>(value);
+  let exponent = <i32>(bits >> 52) & 0x7FF;
+  let mantissa = bits & 0xFFFFFFFFFFFFF;
+  if (exponent == 0) exponent = 1;
+  else mantissa |= 1 << 52;
+  exponent -= 1075;
+
+  let limbs: u32[] = [<u32>mantissa, <u32>(mantissa >> 32)];
+  for (let i = 0; i < places; i++) multiplyLimbs(limbs, 10);
+
+  if (exponent >= 0) {
+    shiftLimbsLeft(limbs, exponent);
+  } else {
+    addBit(limbs, -exponent - 1);
+    shiftLimbsRight(limbs, -exponent);
+  }
+  return limbsToDecimal(limbs);
+}
+
+function multiplyLimbs(limbs: u32[], factor: u32): void {
+  let carry: u64 = 0;
+  for (let i = 0; i < limbs.length; i++) {
+    let product = <u64>limbs[i] * factor + carry;
+    limbs[i] = <u32>product;
+    carry = product >> 32;
+  }
+  if (carry != 0) limbs.push(<u32>carry);
+}
+
+function shiftLimbsLeft(limbs: u32[], count: i32): void {
+  for (let i = 0; i < count >> 5; i++) limbs.unshift(0);
+  let rest = count & 31;
+  if (rest == 0) return;
+  let carry: u32 = 0;
+  for (let i = 0; i < limbs.length; i++) {
+    let limb = limbs[i];
+    limbs[i] = (limb << rest) | carry;
+    carry = limb >> (32 - rest);
+  }
+  if (carry != 0) limbs.push(carry);
+}
+
+function shiftLimbsRight(limbs: u32[], count: i32): void {
+  let words = min(count >> 5, limbs.length);
+  for (let i = 0; i < words; i++) limbs.shift();
+  let rest = count & 31;
+  if (rest == 0) return;
+  for (let i = 0; i < limbs.length; i++) {
+    let higher: u32 = i + 1 < limbs.length ? limbs[i + 1] : 0;
+    limbs[i] = (limbs[i] >> rest) | (higher << (32 - rest));
+  }
+}
+
+/** Adds 2^bit: half of what the shift after it drops, so the shift rounds. */
+function addBit(limbs: u32[], bit: i32): void {
+  let at = bit >> 5;
+  while (limbs.length <= at) limbs.push(0);
+  let carry: u64 = <u64>1 << (bit & 31);
+  for (let i = at; i < limbs.length && carry != 0; i++) {
+    let sum = <u64>limbs[i] + carry;
+    limbs[i] = <u32>sum;
+    carry = sum >> 32;
+  }
+  if (carry != 0) limbs.push(<u32>carry);
+}
+
+/** The whole number in decimal, nine digits at a time from the lowest. */
+function limbsToDecimal(limbs: u32[]): String {
+  let text = "";
+  dropZeroLimbs(limbs);
+  while (limbs.length > 0) {
+    let remainder: u64 = 0;
+    for (let i = limbs.length - 1; i >= 0; i--) {
+      let current = (remainder << 32) | limbs[i];
+      limbs[i] = <u32>(current / 1000000000);
+      remainder = current % 1000000000;
+    }
+    dropZeroLimbs(limbs);
+    let chunk = utoa32(<u32>remainder, 10);
+    // A chunk below the top one keeps its leading zeros.
+    text = (limbs.length > 0 ? "0".repeat(9 - chunk.length) : "") + chunk + text;
+  }
+  return text.length > 0 ? text : "0";
+}
+
+function dropZeroLimbs(limbs: u32[]): void {
+  while (limbs.length > 0 && limbs[limbs.length - 1] == 0) limbs.pop();
 }
 
 export { F64 as Number };
