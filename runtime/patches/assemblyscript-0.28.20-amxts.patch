+    box = this.makeTdzCheck(local, box, reportNode);
+    let getFn = this.asyncHood("__box_get", reportNode, [ type ]);
+    if (!getFn) return module.unreachable();
+    let expr = this.makeCallDirect(getFn, [ box ], reportNode);
+    this.currentType = type;
+    return expr;
+  }
+
+  /** amxts: assigns a variable that lives in a box - its own function's, or a captured one. */
+  private makeCapturedAssignment(local: Local, valueExpr: ExpressionRef, tee: bool): ExpressionRef {
+    let module = this.module;
+    let flow = this.currentFlow;
+    let type = local.type;
+    let reportNode = local.declaration;
+    let box: ExpressionRef;
+    if (local.parent == flow.targetFunction) {
+      box = module.local_get(local.closureBox, this.options.usizeType.toRef());
+    } else if (local.closureBox >= 0) {
+      box = this.makeClosureSlot(local, reportNode);
+    } else {
+      this.error(
+        DiagnosticCode.Not_implemented_0,
+        reportNode.range,
+        `Closures: '${local.name}' is assigned inside a closure that has a copy of it - rename the closure's own variable of that name`
