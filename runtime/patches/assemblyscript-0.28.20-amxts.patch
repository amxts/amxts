+    let next = i + 1 < text.length ? text.charCodeAt(i + 1) : 0;
+    return next >= 0xDC00 && next <= 0xDFFF;
+  }
+  let previous = i > 0 ? text.charCodeAt(i - 1) : 0;
+  return previous >= 0xD800 && previous <= 0xDBFF;
