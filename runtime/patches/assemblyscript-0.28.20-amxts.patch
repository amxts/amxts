+        case 0x5C: parts.push("\\"); break;
+        case 0x2F: parts.push("/"); break;
+        case 0x62: parts.push("\b"); break;
+        case 0x66: parts.push("\f"); break;
+        case 0x6E: parts.push("\n"); break;
+        case 0x72: parts.push("\r"); break;
+        case 0x74: parts.push("\t"); break;
