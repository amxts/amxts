+  run(): void {
+    let module = this.module;
+    let moduleRef = module.ref;
+    for (let i: Index = 0, k = _BinaryenGetNumFunctions(moduleRef); i < k; ++i) {
+      let func = _BinaryenGetFunctionByIndex(moduleRef, i);
+      if (!_BinaryenFunctionGetBody(func)) continue;
+      this.current = assert(module.readStringCached(_BinaryenFunctionGetName(func)));
+      this.walkFunction(func);
+    }
+  }
+
+  /** The functions that call any of `targets`, themselves or through others. */
+  reaching(targets: Set<string>): Set<string> {
+    let found = new Set<string>();
+    let pending = Set_values(targets);
+    while (pending.length) {
+      let callers = this.callers.get(assert(pending.pop()));
+      if (!callers) continue;
+      for (let i = 0, k = callers.length; i < k; ++i) {
+        let caller = callers[i];
+        if (found.has(caller)) continue;
+        found.add(caller);
+        pending.push(caller);
