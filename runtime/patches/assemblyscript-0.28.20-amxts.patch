+    let signature = original.signature;
+    let entry = new Function(
+      original.name + STUB_DELIMITER + "coroutine",
+      original.prototype,
+      original.typeArguments,
+      signature.clone(signature.parameterTypes.length),
+      original.contextualTypeArguments
+    );
+    entry.original = original;
