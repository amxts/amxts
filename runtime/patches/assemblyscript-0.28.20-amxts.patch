+      let high = low;
+      if (low >= 0 && this.eat(0x2C /* , */)) {
+        high = this.more() && this.peek() == 0x7D ? -1 : this.number();
+        if (high == -1 && !(this.more() && this.peek() == 0x7D)) low = -1;
+      }
+      if (low < 0 || !this.eat(0x7D /* } */)) {
+        this.pos = start;
+        return atom;
+      }
+      if (high >= 0 && high < low) this.fail("numbers out of order in {} quantifier");
+      min = low;
+      max = high;
+    } else {
+      return atom;
+    }
+    if (atom.kind == N_ASSERT || atom.kind == N_LOOK) this.fail("Nothing to repeat");
+    let node = new RegExpNode(N_REPEAT, 0, min, max, !this.eat(0x3F));
+    node.children.push(atom);
+    return node;
+  }
+
+  /** Digits as a number, -1 when there are none. */
+  number(): i32 {
+    let value = -1;
+    while (this.more()) {
+      let c = this.peek();
+      if (c < 0x30 || c > 0x39) break;
+      value = (value < 0 ? 0 : value * 10) + (c - 0x30);
+      this.pos++;
+    }
+    return value;
+  }
