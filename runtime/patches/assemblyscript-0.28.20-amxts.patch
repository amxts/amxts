+    // Then the functions themselves, into their boxes.
+    let usizeRef = this.options.usizeType.toRef();
+    for (let i = 0, k = declarations.length; i < k; ++i) {
+      let local = names[i];
+      if (!local) continue;
+      let type = local.type;
+      let expr = this.compileExpression(declarations[i], type, Constraints.ConvImplicit);
+      let setFn = this.asyncHood("__box_set", declarations[i], [ type ]);
+      if (!setFn) continue;
+      stmts.push(module.drop(this.makeCallDirect(setFn, [ module.local_get(local.closureBox, usizeRef), expr ], declarations[i])));
+    }
+    return hoisted;
+  }
+
+  /** amxts: the flow of the function that declares `local`, as it was where the closure was written. */
+  private ownerFlowOf(local: Local): Flow | null {
+    let flow: Flow | null = this.currentFlow.outer;
+    while (flow && flow.targetFunction != local.parent) flow = flow.outer;
+    return flow;
+  }
+
+  /**
+   * amxts: whether a captured local without a box may be copied into the
+   * closure: nothing assigns it after its declaration. An error if not.
+   */
+  private checkCopyable(local: Local, reportNode: Node): bool {
+    if (!local.closureAssigned) return true;
+    // scanClosures saw the closure use it, so it has a box: this is the
+    // compiler's own mistake, not the plugin's.
+    this.error(
+      DiagnosticCode.Not_implemented_0,
+      reportNode.range,
+      `Closures: '${local.name}' is assigned but has no box - a compiler error, please report it`
+    );
+    return false;
+  }
+
+  /**
+   * amxts: the slot of the closure being compiled that holds `local`, read
+   * from its `_env` - the local's box, or its copy.
+   */
+  private makeClosureSlot(local: Local, reportNode: Node): ExpressionRef {
+    let module = this.module;
+    let flow = this.currentFlow;
+    let instance = flow.targetFunction;
+    let usizeType = this.options.usizeType;
+    if (!instance.flow.outer) {
+      this.error(
+        DiagnosticCode.Not_implemented_0,
+        reportNode.range,
+        `Closures: '${local.name}' belongs to another function, and this one is not a function expression written inside it`
+      );
+      return module.unreachable();
+    }
+    let slots = instance.closureSlots;
+    if (!slots) instance.closureSlots = slots = new Array<Local>();
+    let index = slots.indexOf(local);
+    if (index < 0) {
+      index = slots.length;
+      slots.push(local);
+    }
+    let env = instance.closureEnv;
+    if (!env) instance.closureEnv = env = instance.addLocal(usizeType);
+    let usizeRef = usizeType.toRef();
+    return module.load(usizeType.byteSize, false, module.local_get(env.index, usizeRef), usizeRef, index * usizeType.byteSize);
