+  get(key: string): __JsonValue | null {
+    let keys = this.keys;
+    if (!keys) return null;
+    for (let i = keys.length - 1; i >= 0; --i) {
+      if (unchecked(keys[i]) == key) return unchecked((<__JsonValue[]>this.items)[i]);
+    }
+    return null;
+  }
+
+  /** What JSON text calls this value's kind, for a message. */
+  get kindName(): string {
+    switch (this.kind) {
+      case BOOLEAN: return "a boolean";
+      case NUMBER: return "a number";
+      case STRING: return "text";
+      case ARRAY: return "an array";
+      case OBJECT: return "an object";
+    }
+    return "null";
+  }
+}
