+// amxts: JSON as JavaScript has it, typed. JSON.parse<T>(text) - or
+// `JSON.parse(text) as T` - builds a T from the text: what T is the compiler
+// knows, so __jsonRead walks it, field by field for an object
+// (Compiler.compileJsonReadFields). JSON.stringify(value) writes any value a
+// plugin has: text, numbers, booleans, arrays, Records, objects of fields
+// (Compiler.compileJsonWriteFields), a Date as its ISO text, an object with a
+// toJSON() as what that gives.
+
+import { dtoa } from "./util/number";
+
+// @ts-ignore: decorator
+@inline const NULL = 0;
+// @ts-ignore: decorator
+@inline const BOOLEAN = 1;
+// @ts-ignore: decorator
+@inline const NUMBER = 2;
+// @ts-ignore: decorator
+@inline const STRING = 3;
+// @ts-ignore: decorator
+@inline const ARRAY = 4;
+// @ts-ignore: decorator
+@inline const OBJECT = 5;
