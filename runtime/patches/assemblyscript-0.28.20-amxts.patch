+  let copy = __new(offsetof<Function<() => void>>(), load<u32>(fn - 8));
+  store<u32>(copy, load<u32>(fn), offsetof<Function<() => void>>("_index"));
+  store<usize>(copy, env, offsetof<Function<() => void>>("_env"));
