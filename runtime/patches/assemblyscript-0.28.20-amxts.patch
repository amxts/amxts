+      value = value * 16 + d;
+    }
+    return value;
+  }
+
+  addClass(cls: RegExpClass): i32 {
+    this.classes.push(cls);
+    return this.classes.length - 1;
+  }
+
+  /** `[...]`, after its `[`. */
+  bracketClass(): i32 {
+    let cls = new RegExpClass();
+    cls.negate = this.eat(0x5E /* ^ */);
+    let ranges = cls.ranges;
+    while (true) {
+      if (!this.more()) this.fail("Unterminated character class");
+      let c = this.next();
+      if (c == 0x5D /* ] */) break;
+      let low = c;
+      if (c == 0x5C) {
+        let e = this.next();
+        let shorthand = e | 0x20;
+        if (shorthand == 0x64 || shorthand == 0x77 || shorthand == 0x73) {
+          if (e < 0x60) addNegatedShorthand(ranges, shorthand);
+          else addShorthand(ranges, shorthand);
+          continue;
+        }
+        low = e == 0x62 ? 0x08 : this.escapedChar(e); // [\b] is a backspace
+      }
+      let high = low;
+      if (this.more() && this.peek() == 0x2D /* - */ && this.pos + 1 < this.pattern.length && this.pattern.charCodeAt(this.pos + 1) != 0x5D) {
+        this.pos++;
+        high = this.next();
+        if (high == 0x5C) high = this.escapedChar(this.next());
+        if (high < low) this.fail("Range out of order in character class");
+      }
+      ranges.push(low);
+      ranges.push(high);
+    }
+    return this.addClass(cls);
+  }
+}
+
+/** The first capturing group inside a node, 0 for none. */
+function firstGroup(node: RegExpNode): i32 {
+  if (node.kind == N_GROUP && node.value > 0) return node.value;
+  let children = node.children;
+  for (let i = 0, k = children.length; i < k; ++i) {
+    let found = firstGroup(children[i]);
+    if (found) return found;
+  }
+  return 0;
+}
+
+/** The last capturing group inside a node, 0 for none - they are numbered in order. */
+function lastGroup(node: RegExpNode): i32 {
+  let last = node.kind == N_GROUP && node.value > 0 ? node.value : 0;
+  let children = node.children;
+  for (let i = 0, k = children.length; i < k; ++i) last = max(last, lastGroup(children[i]));
+  return last;
+}
+
+function addShorthand(ranges: i32[], shorthand: i32): void {
+  if (shorthand == 0x64) { // \d
+    ranges.push(0x30); ranges.push(0x39);
+  } else if (shorthand == 0x77) { // \w
+    ranges.push(0x30); ranges.push(0x39);
+    ranges.push(0x41); ranges.push(0x5A);
+    ranges.push(0x5F); ranges.push(0x5F);
+    ranges.push(0x61); ranges.push(0x7A);
+  } else { // \s
+    ranges.push(0x09); ranges.push(0x0D);
+    ranges.push(0x20); ranges.push(0x20);
+    ranges.push(0xA0); ranges.push(0xA0);
+    ranges.push(0x1680); ranges.push(0x1680);
+    ranges.push(0x2000); ranges.push(0x200A);
+    ranges.push(0x2028); ranges.push(0x2029);
+    ranges.push(0x202F); ranges.push(0x202F);
+    ranges.push(0x205F); ranges.push(0x205F);
+    ranges.push(0x3000); ranges.push(0x3000);
+    ranges.push(0xFEFF); ranges.push(0xFEFF);
+  }
+}
+
+/** \D, \W or \S inside a class: the ranges between the shorthand's. */
+function addNegatedShorthand(ranges: i32[], shorthand: i32): void {
+  let own = new Array<i32>();
+  addShorthand(own, shorthand);
+  let from = 0;
+  for (let i = 0, k = own.length; i < k; i += 2) {
+    if (own[i] > from) { ranges.push(from); ranges.push(own[i] - 1); }
+    from = own[i + 1] + 1;
+  }
+  if (from <= 0xFFFF) { ranges.push(from); ranges.push(0xFFFF); }
+}
+
+/** The compiler: a tree into the matcher's program. */
+class RegExpCompiler {
+  code: i32[] = [];
+  registers: i32 = 0;
+
+  emit(op: i32, a: i32 = 0, b: i32 = 0): i32 {
+    let at = this.code.length / 3;
+    this.code.push(op);
+    this.code.push(a);
+    this.code.push(b);
+    return at;
+  }
+
+  patch(at: i32, a: i32, b: i32): void {
+    this.code[at * 3 + 1] = a;
+    this.code[at * 3 + 2] = b;
+  }
+
+  here(): i32 { return this.code.length / 3; }
+
+  node(node: RegExpNode, dotAll: bool): void {
+    let children = node.children;
+    switch (node.kind) {
+      case N_CHAR: { this.emit(OP_CHAR, node.value); break; }
+      case N_ANY: { this.emit(OP_ANY, dotAll ? 1 : 0); break; }
+      case N_CLASS: { this.emit(OP_CLASS, node.value); break; }
+      case N_ASSERT: { this.emit(node.value, node.min); break; }
+      case N_BACKREF: { this.emit(OP_BACKREF, node.value); break; }
+      case N_SEQ: {
+        for (let i = 0, k = children.length; i < k; ++i) this.node(children[i], dotAll);
+        break;
+      }
+      case N_GROUP: {
+        if (node.value >= 0) this.emit(OP_SAVE, node.value * 2);
+        this.node(children[0], dotAll);
+        if (node.value >= 0) this.emit(OP_SAVE, node.value * 2 + 1);
+        break;
+      }
+      case N_LOOK: {
+        let look = this.emit(OP_LOOK, node.value);
+        this.node(children[0], dotAll);
+        this.emit(OP_MATCH);
+        this.patch(look, node.value, this.here());
+        break;
+      }
+      case N_ALT: {
+        let jumps = new Array<i32>();
+        for (let i = 0, k = children.length; i < k; ++i) {
+          let split = i < k - 1 ? this.emit(OP_SPLIT) : -1;
+          this.node(children[i], dotAll);
+          if (i < k - 1) {
+            jumps.push(this.emit(OP_JMP));
+            this.patch(split, split + 1, this.here());
+          }
+        }
+        for (let i = 0, k = jumps.length; i < k; ++i) this.patch(jumps[i], this.here(), 0);
+        break;
+      }
+      case N_REPEAT: {
+        let child = children[0];
+        // each round starts with the groups inside it unmatched, as in JavaScript
+        let first = firstGroup(child);
+        let clear = first > 0;
+        let last = clear ? lastGroup(child) : 0;
+        for (let i = 0; i < node.min; ++i) {
+          if (clear) this.emit(OP_CLEAR, first * 2, last * 2 + 1);
+          this.node(child, dotAll);
+        }
+        if (node.max < 0) {
+          // loop: split body/out; body; progress check; jmp loop
+          let register = this.registers++;
+          let loop = this.emit(OP_SPLIT);
+          let body = this.emit(OP_MARK, register);
+          if (clear) this.emit(OP_CLEAR, first * 2, last * 2 + 1);
+          this.node(child, dotAll);
+          this.emit(OP_PROGRESS, register);
+          this.emit(OP_JMP, loop);
+          let out = this.here();
+          if (node.greedy) this.patch(loop, body, out);
+          else this.patch(loop, out, body);
+        } else {
+          let splits = new Array<i32>();
+          for (let i = node.min; i < node.max; ++i) {
+            splits.push(this.emit(OP_SPLIT));
+            if (clear) this.emit(OP_CLEAR, first * 2, last * 2 + 1);
+            this.node(child, dotAll);
+          }
+          let out = this.here();
+          for (let i = 0, k = splits.length; i < k; ++i) {
+            let split = splits[i];
+            if (node.greedy) this.patch(split, split + 1, out);
+            else this.patch(split, out, split + 1);
+          }
+        }
+        break;
+      }
+    }
+  }
+}
+
+/** What a match of exec gives: the text matched and its groups, and where. */
+export class RegExpExecArray extends Array<string> {
+  /** Where the match starts in the text. */
+  index: i32 = 0;
+  /** The text searched. */
+  input: string = "";
+}
+
 export class RegExp {
+  readonly source: string;
+  readonly flags: string;
+  readonly global: bool;
+  readonly ignoreCase: bool;
+  readonly multiline: bool;
