+  }
+
+  more(): bool { return this.pos < this.pattern.length; }
+  peek(): i32 { return this.pattern.charCodeAt(this.pos); }
+  next(): i32 { return this.pattern.charCodeAt(this.pos++); }
+
+  eat(c: i32): bool {
+    if (this.more() && this.peek() == c) {
